{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pbtv/news",
	"title": "News",
	"category": "widgets",
	"icon": "rss",
	"description": "Displays the latest news items from curated RSS feeds, filtered by topic.",
	"textdomain": "pbtv",
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Últimas notícias"
		},
		"maxItems": {
			"type": "number",
			"default": 8
		}
	},
	"supports": {
		"html": false,
		"align": false,
		"anchor": true,
		"interactivity": true
	},
	"editorScript": "pbtv-news-editor",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
