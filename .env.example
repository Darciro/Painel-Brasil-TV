# Copy this file to .env and fill in real values. Never commit .env.
# On a docker server it should be placed on /opt/pbtv/.env

# Database
DB_NAME=pbtv
DB_USER=pbtv
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
WP_TABLE_PREFIX=wp_pbtv_

# WordPress
WP_PORT=8080
WP_DEBUG=0

# phpMyAdmin
PMA_PORT=8081

# Theme
PBTV_YOUTUBE_API_KEY=
